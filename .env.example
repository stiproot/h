# ── Claude agent ──────────────────────────────────────────────────────────────
# Auth is either/or: set ANTHROPIC_API_KEY for pay-as-you-go API billing, OR set
# CLAUDE_CODE_OAUTH_TOKEN to run the `claude` CLI on a Claude Max/Pro subscription
# (generate once with `claude setup-token`). Leave ANTHROPIC_API_KEY blank when using
# the token — an empty value is left unset so it can't shadow the subscription.
# NOTE: only the claude-agent (which shells out to the CLI) can use the token; the
# other agents talk to the API/LiteLLM directly and still need ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. The Anthropic-compatible endpoint the agents talk to, e.g.
# https://api.anthropic.com or your LiteLLM proxy URL. Leave blank for the token path.
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-haiku-4-5

# ── OpenHands agent ───────────────────────────────────────────────────────────
# LLM_API_KEY / LLM_BASE_URL are the provider-neutral endpoint knobs, shared with
# dapr-agent (see below). Point them at any OpenAI-compatible endpoint.
LLM_API_KEY=
# Required — no code default. An OpenAI-compatible base URL: your LiteLLM proxy, or a
# provider's native endpoint (e.g. DeepSeek: https://api.deepseek.com/v1).
LLM_BASE_URL=
# A bare id routes as an OpenAI-compatible call via LLM_BASE_URL; a LiteLLM
# provider-prefixed id (e.g. deepseek/deepseek-v4-flash, anthropic/…) routes as-is.
OPENHANDS_MODEL=claude-sonnet-4-6

# ── pi coding-agent ───────────────────────────────────────────────────────────
# pi uses provider env vars directly: ANTHROPIC_API_KEY for anthropic/* models, or
# OPENAI_API_KEY + OPENAI_BASE_URL for openai/* models and LiteLLM proxy routes.
# LLM_API_KEY / LLM_BASE_URL (shared with OpenHands) are translated by the pi strategy.
# A bare model id is prefixed with openai/ and routed via LLM_BASE_URL; a provider-
# prefixed id (e.g. anthropic/claude-sonnet-4-6) is passed through unchanged.
PI_MODEL=claude-sonnet-4-6

# ── Codex agent ───────────────────────────────────────────────────────────────
# OpenAI API credential and model used by the Codex coding agent.
# OPENAI_API_KEY=
# CODEX_MODEL=o4-mini
# CODEX_AUTH_MODE=chatgpt

# ── DeepSeek (worked example: any OpenAI-compatible provider) ─────────────────
# To run OpenHands, pi, and/or dapr-agent on DeepSeek V4, point the provider-neutral LLM_*
# vars at DeepSeek and pick each agent's model:
#   LLM_API_KEY=<your DeepSeek key>
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   OPENHANDS_MODEL=deepseek-v4-flash      # OpenHands leg
#   PI_MODEL=deepseek-v4-flash             # pi leg
#   DAPR_AGENT_MODEL=deepseek-v4-flash     # dapr-agent leg
# Start with deepseek-v4-flash (non-thinking). deepseek-v4-pro (thinking) returns a
# reasoning_content field that must be threaded back on multi-turn tool calls — not yet
# supported (see docs/plans/model-provider-integration.md §2 + progress log).

# ── GitHub ────────────────────────────────────────────────────────────────────
# The main GitHub credential: authenticates the hosted github MCP on claude-agent
# (issue reads, labels, comments, PR creation) and, when GIT_AUTH is unset/pat, git
# clone/fetch/push via one-shot token URLs (git-core injects it per-invocation; it is
# never persisted into git config or workflow definitions). For the h-builds-h loop's
# owner-repo trial this is YOUR fine-grained PAT: repo-scoped, contents:write +
# pull_requests:write + issues:read/write.
GH_TOKEN=
# Git transport strategy for /clone + /worktree (git-core GitAuth): "ssh" rewrites
# github URLs to git@github.com: and pushes over your key; unset/"pat" uses GH_TOKEN
# URLs. GIT_SSH_KEY_PATH names a specific key (empty = ambient ssh config/agent).
# GIT_AUTH=ssh
# GIT_SSH_KEY_PATH=

# ── Tessl ─────────────────────────────────────────────────────────────────────
# Long-lived API key for non-interactive tessl install inside agent workspaces.
# Generate with: tessl api-key create --name h
TESSL_API_KEY=
# Short-lived Tessl authentication token used by Compose, Kubernetes, and local runners.
TESSL_TOKEN=

# ── Notion ────────────────────────────────────────────────────────────────────
# Bearer token for the notion MCP server on claude-agent's .mcp.json.
# Use a Notion Personal Access Token (user-scoped; sees every page you can see, no
# per-page sharing) or an internal integration token. Create one at
# https://www.notion.so/my-integrations. NOTE: PATs expire 1 year after creation.
NOTION_API_KEY=

# ── agent-dapr ────────────────────────────────────────────────────────────────
# AGENT_DAPR_BASE_DIR=
# TESSL_BIN=/usr/local/bin/tessl
# LLM config resolves provider-neutral first, Anthropic-named as fallback: base URL =
# LLM_BASE_URL or ANTHROPIC_BASE_URL; key = LLM_API_KEY or ANTHROPIC_API_KEY; model =
# DAPR_AGENT_MODEL (falls back to the shared AGENT_MODEL / claude-haiku-4-5). Stays on
# Claude by default; switches to DeepSeek via the LLM_* vars + DAPR_AGENT_MODEL above.
# DAPR_AGENT_MODEL=

# ── agent-langgraph ───────────────────────────────────────────────────────────
# Pure LangChain/LangGraph ReAct agent. Talks to the LiteLLM proxy directly via
# ChatAnthropic, so it reuses the shared ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL /
# AGENT_MODEL / AGENT_MAX_ITERATIONS vars above.

# ── workflow-agent ────────────────────────────────────────────────────────────
# Cron-triggered orchestrator (Dapr Agents SDK) that builds/runs workflows via the
# workflows MCP. Reuses ANTHROPIC_* / AGENT_MODEL / AGENT_MAX_ITERATIONS above.
# WORKFLOWS_MCP_URL=http://localhost:8005/sse   # local; docker uses http://workflows-mcp:8000/sse
#
# For production-ops use-cases the claude-agent needs production access:
#   - AWS: log in to your SSO session on the host (local run inherits it; docker mounts ~/.aws).
#     AWS_PROFILE and AWS_REGION are passed through to the claude-agent container.
#   - Linear MCP (richer issue context): added to claude-agent's .mcp.json; complete Linear auth.
#
# SECURITY: the claude-agent runs tasks whose prompts are composed by the workflow-agent's LLM.
# "Read-only" is NOT enforced by the prompt — it is only as safe as (a) the IAM permissions of the
# SSO role you log in with and (b) the scopes of the Linear token. Use a READ-ONLY SSM role for the
# AWS session. The Linear MCP is on the shared claude-agent config, so its write tools are reachable
# by any claude-agent task, not just the ops ones. Scope these credentials accordingly.
# AWS_PROFILE=
# AWS_REGION=
# LINEAR_API_KEY=

# ── Worktree-cutting workflows (grooming, triage, feature-request) ───────────
# The repo those workflows investigate/change, pre-cloned by cli/scripts/clone.sh.
# Required by clone.sh — no in-repo default.
# TARGET_REPO_URL=https://github.com/your-org/your-repo.git
# TARGET_REPO_CANONICAL_URL=    # optional; origin is normalised to this (defaults to TARGET_REPO_URL)
# TARGET_REPO_DIR=repo          # optional; dir name under the shared workspace root

# ── plugin-feedback loop (workflow-agent) ─────────────────────────────────────
# Where plugin-improvement tasks land when a plugin-feedback event doesn't carry
# repo/tilePath fields. No in-code default — events are skipped if neither is set.
# PLUGIN_FEEDBACK_REPO=your-org/your-repo
# PLUGIN_FEEDBACK_TILE_PATH=path/to/your-plugin/

# ── Test script overrides (optional) ─────────────────────────────────────────
# WORKFLOW_URL=http://localhost:8003
# SIDECAR_URL=http://localhost:3503
# POLL_INTERVAL=5
# TIMEOUT=600
