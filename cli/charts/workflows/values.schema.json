{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Shape validation only. Required-ness is enforced per-template with helm's `required` function, so rendering one workflow template never demands another template's values.",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "$comment": "Set by the renderer to the selected template; gates which template body evaluates (helm evaluates all templates even under -s)."
    },
    "publish": {
      "type": "boolean",
      "$comment": "Emit per-run inputs as {{params.*}} tokens (a saveable template) instead of literals."
    },
    "composable": {
      "type": "boolean",
      "$comment": "Overlay mode: render a template as an overlay-able atom — feature omits its standalone commit-decision closer so a create-pr overlay supplies it. Set by `h workflow compose`."
    },
    "feature": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "$comment": "Git-branch-safe: lowercase alphanumerics and hyphens, no leading/trailing hyphen. Empty passes shape validation; the template rejects it via `required`."
        },
        "spec": {
          "type": "string"
        },
        "clonePath": {
          "type": "string"
        },
        "remoteBase": {
          "type": "string"
        },
        "gitAuth": {
          "enum": [
            "",
            "pat",
            "ssh"
          ],
          "$comment": "Git auth strategy name for worktree/clone + the push instruction; secrets stay in the agent env. Empty = the agent's GIT_AUTH default."
        },
        "models": {
          "type": "object",
          "properties": {
            "plan": {
              "type": "string"
            },
            "implement": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "$comment": "verify overlay template (templates/verify.yaml). cmd bakes from values at compose/publish time.",
      "properties": {
        "cmd": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "createPr": {
      "type": "object",
      "$comment": "create-pr overlay template (templates/create-pr.yaml). Publish-native: slug/createPr/issueNumber are fire-time params; only gitAuth bakes here.",
      "properties": {
        "gitAuth": {
          "enum": [
            "",
            "pat",
            "ssh"
          ]
        }
      },
      "additionalProperties": false
    },
    "pluginImprovement": {
      "type": "object",
      "properties": {
        "clonePath": {
          "type": "string"
        },
        "tile": {
          "type": "string"
        },
        "remoteBase": {
          "type": "string"
        },
        "verifyCmd": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "properties": {
            "improve": {
              "type": "string"
            },
            "verify": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prReview": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "properties": {
            "review": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "issueSweep": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1
        },
        "coderWorkflowUrl": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "models": {
          "type": "object",
          "properties": {
            "sweep": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
