{
  "name": "agent-server",
  "version": "0.1.0",
  "description": "Shared HTTP route boilerplate for h agent services (run/setup/dapr-subscribe)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "oxlint src && oxfmt --check src",
    "format": "oxfmt src",
    "test": "node ../../../scripts/check-workspace-built.mjs && vitest run"
  },
  "dependencies": {
    "@effect/platform": "^0.96.2",
    "core": "workspace:*",
    "effect": "^3.21.4",
    "fastify": "^5.0.0",
    "git-core": "workspace:*",
    "telemetry": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "^0.107.0",
    "@effect/vitest": "^0.29.0",
    "@types/node": "^24"
  }
}
