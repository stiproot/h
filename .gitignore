# secrets
.env
.env.*
!.env.example
secrets/*
!secrets/*.example
k8s/secrets/app-secrets.yaml
.claude/settings.local.json

# domain-specific workflow payloads, feature-request specs, and docs
# (org/deployment-specific content; the generic machinery and demo payloads
# in cli/scripts/payloads/ are committed — see cli/scripts/payloads/README.md)
cli/scripts/payloads/domain/*
!cli/scripts/payloads/domain/README.md

# org-specific chart value overrides (real repo paths, model ids — merged by
# render_workflow in cli/scripts/_render.sh when present)
cli/charts/*/values.local.yaml

# local scratch
tmp/
.claude/worktrees/

# Dapr runtime
dapr-etcd/

# Workflow artifacts
output/
workspace/

# Node
node_modules/
dist/
build/
coverage/
.turbo/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
*.log

# Domain-specific plans (h-change context with domain details) stay local; core-architecture plans are source-controlled.
docs/plans/domain/

# Headless host-mode launcher logs + pidfiles (cli/scripts/up-local.sh)
.local-logs/

# diagram communication layer — sources are the truth; renders + tooling are local
docs/diagrams/rendered/
tools/diagrams/.deps/
