{
  "steps": [
    {
      "id": "setup-openhands",
      "activity": "setup",
      "input": {
        "agentId": "openhands-agent",
        "setup": [
          {
            "cmd": "printf \"{}\" > tessl.json"
          },
          {
            "cmd": "tessl init"
          },
          {
            "cmd": "tessl install github:Dokhacgiakhoa/antigravity-ide@332e58b --skill api-patterns --agent openhands",
            "validateCmd": "find .openhands/skills -maxdepth 1 -type d -name \"*api-patterns*\" | grep -q ."
          }
        ]
      }
    },
    {
      "id": "build-api",
      "activity": "run-openhands",
      "input": {
        "task": "Use the /api-patterns skill to implement a simple Node API in a hex-api/ directory that translates English text to hex. It should expose a single POST /translate endpoint. Also add a one-shot bash script (run-and-test.sh) that starts the server and fires a curl request against it."
      }
    },
    {
      "id": "setup-claude",
      "activity": "setup",
      "input": {
        "agentId": "claude-agent",
        "setup": [
          {
            "cmd": "tessl init"
          },
          {
            "cmd": "mkdir -p .claude && cp $AGENT_APP_DIR/.claude/settings.json .claude/settings.json"
          },
          {
            "cmd": "tessl install github:ArabelaTso/Skills-4-SE@0f00a4f --skill code-summarizer"
          }
        ]
      }
    },
    {
      "id": "summarize",
      "activity": "run-claude",
      "input": {
        "task": "Use the /code-summarizer skill to summarize the codebase at {{build-api.workspacePath}}."
      }
    },
    {
      "id": "copy",
      "activity": "copy-session",
      "input": {
        "targetDir": "${TARGET_DIR}",
        "output": {
          "$ref": "summarize.output"
        },
        "sessionId": {
          "$ref": "summarize.sessionId"
        }
      }
    }
  ]
}
