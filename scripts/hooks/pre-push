#!/usr/bin/env bash
# ─── Local pre-push hook ─────────────────────────────────────────────────────
#
# Runs the fast lint guards before every push.  If any guard fails the push is
# blocked.  This is NOT a full build/test — only lint, so it stays well under a
# few seconds for the common case.
#
# Install:
#   make install-hooks        # sets core.hooksPath = scripts/hooks
#
# Skip (emergency use only):
#   git push --no-verify
#
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "━━━ pre-push: running content guards (bun run lint && make lint-py) ━━━"
echo ""

if ! bun run lint; then
  echo ""
  echo "✖ pre-push: one or more guards FAILED — push blocked."
  echo "  To bypass (emergency only): git push --no-verify"
  exit 1
fi

echo ""
echo "━━━ pre-push: running Python lint (make lint-py) ━━━"
echo ""

if ! make lint-py; then
  echo ""
  echo "✖ pre-push: Python lint FAILED — push blocked."
  echo "  To bypass (emergency only): git push --no-verify"
  exit 1
fi

echo ""
echo "✔ pre-push: all guards passed."

# ─── Is main's CI red? ──────────────────────────────────────────────────────
# The guards above are LOCAL; CI runs the tests in a different environment, and nothing else
# in the workflow ever looks at its result. main was red for seventeen days (2026-08-16 →
# 09-02) on a test that only failed under GitHub's env, and every push in that span went out
# green here. This does not block — a push may be the fix — it makes the state impossible to
# not see. Skipped quietly when gh is absent or unauthenticated (offline pushes are legal).
if command -v gh >/dev/null 2>&1; then
  latest="$(gh run list --branch main --limit 1 --json conclusion,headSha,url,createdAt \
    --jq '.[0] | "\(.conclusion // "in-progress") \(.headSha[0:7]) \(.createdAt) \(.url)"' 2>/dev/null || true)"
  case "$latest" in
    failure*)
      echo ""
      echo "⚠ pre-push: main's CI is RED — ${latest}"
      echo "  A green local guard chain does not cover it: fix or triage before adding to the pile."
      ;;
  esac
fi
